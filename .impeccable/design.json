      "html": "<div class=\"ds-header\"><strong>DVS REPAIR</strong><span>Developed by <a href=\"https://github.com/TapeStereo\">TapeStereo</a></span></div>",
      "css": ".ds-header{height:58px;width:900px;max-width:100%;display:flex;align-items:center;justify-content:space-between;padding:0 44px;color:#1F2B43;border-bottom:1px solid #AEBED2;background:linear-gradient(96deg,#D3EBF3 0%,#F9FBFE 17%,#C3EDEE 34%,#D8D3F7 50%,#FFE0E9 66%,#F6F9FA 82%,#BDD9EB 100%);font:400 12px \"Segoe UI\",sans-serif}.ds-header strong{font-size:13px;font-weight:700}@media(forced-colors:active){.ds-header{background:Canvas;color:CanvasText;border-color:CanvasText}}.ds-header a{color:#265B95;text-decoration:none}.ds-header a:hover,.ds-header a:focus-visible{text-decoration:underline}"
