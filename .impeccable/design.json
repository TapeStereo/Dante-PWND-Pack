      "html": "<button class=\"ds-chrome\" type=\"button\"><svg class=\"ds-shield\" width=\"24\" height=\"26\" viewBox=\"0 0 24 26\" aria-hidden=\"true\"><path d=\"M2 5 12 2 22 5 20 17 12 23 4 17Z\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/></svg><span class=\"ds-button-text\">Вылечить DVS от жадности</span><svg class=\"ds-arrow\" width=\"24\" height=\"20\" viewBox=\"0 0 24 20\" aria-hidden=\"true\"><path d=\"M2 10H20M14 4 20 10 14 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"/></svg></button>",
